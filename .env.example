# Local demo credentials only. Copy to .env; never use these in a hosted environment.
POSTGRES_PASSWORD=switchyard-local-only
DATABASE_URL=postgres://switchyard:switchyard-local-only@127.0.0.1:54329/switchyard?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
DB_MAX_CONNS=10
SWITCHYARD_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# In-memory snapshots are enabled; Redis is an optional disposable cache tier.
CACHE_ENABLED=true
REDIS_URL=redis://127.0.0.1:63799/0
NATS_URL=nats://127.0.0.1:42229

# Normal Docker operation schedules bounded cleanup after the M7 aggregate-read gate.
WORKER_RETENTION_ENABLED=true
RAW_RETENTION_DAYS=7
SUMMARY_RETENTION_DAYS=90
