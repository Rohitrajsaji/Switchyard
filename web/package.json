{
  "name": "switchyard-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "build": "next build",
    "start": "next start --hostname localhost",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write src test e2e next.config.ts playwright.config.ts tsconfig.json package.json",
    "format-check": "prettier --check src test e2e next.config.ts playwright.config.ts tsconfig.json package.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lossless-json": "4.3.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
