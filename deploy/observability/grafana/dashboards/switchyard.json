{
 "uid": "switchyard-overview",
 "title": "Switchyard overview",
 "tags": [
  "switchyard"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "HTTP requests/s by route",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (route)(rate(switchyard_http_requests_total[1m]))",
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "HTTP latency p50 / p95 / p99 (all routes)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
